    <!-- About -->
    <string name="about_title">About</string>
    <string name="about_version">Version %1$s (%2$d)</string>
    <string name="about_body">AuraPulse plays your own audio with Media3, backed by a local Room library. It has no analytics, no ads and no hidden uploads. Online features talk only to the endpoints you can see: iTunes Search, Radio Browser and api.github.com.</string>
    <string name="about_license">Licensed under AGPL-3.0-or-later.</string>
    <string name="about_source">Source code</string>
    <string name="about_privacy">Privacy</string>
    <string name="about_privacy_body">Files, playback history and favourites stay on the device. A GitHub token is encrypted at rest and only used for the API calls you trigger. Gist backups contain playlists and links, never audio.</string>

    <!-- Onboarding -->
    <string name="onboarding_skip">Skip</string>
    <string name="onboarding_next">Next</string>
    <string name="onboarding_start">Start listening</string>
    <string name="onboarding_one_title">Your files stay yours</string>
    <string name="onboarding_one_body">AuraPulse reads the audio you pick through Android’s system file picker. It never moves, renames or deletes anything.</string>
    <string name="onboarding_two_title">Motion with meaning</string>
    <string name="onboarding_two_body">Built on Material 3 Expressive: spring physics, shape morphing and an interface that reacts to every touch.</string>
    <string name="onboarding_three_title">Optional cloud, honest cloud</string>
    <string name="onboarding_three_body">Sign in with GitHub to keep playlists in a private gist. Audio never leaves the device — no account is required to listen.</string>

